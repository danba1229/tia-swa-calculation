KAKAO_JS_KEY=your_kakao_javascript_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key
# Shared server-only key for KOROAD statistics and accident hotspot APIs.
KOROAD_API_KEY=
# HTTP-only Seoul BIS endpoint: use a key dedicated to this service only.
# It must differ from every other key below, or bus detail lookups are refused.
SEOUL_BUS_API_KEY=your_seoul_bus_public_data_service_key
GYEONGGI_BUS_STATION_API_KEY=
GYEONGGI_BUS_ROUTE_API_KEY=
GYEONGGI_BUS_BASE_API_KEY=
# Server-only Gyeonggi Data Dream continuous hourly traffic API key.
GG_DATA_DREAM_API_KEY=
TAGO_SUBWAY_API_KEY=
SEOUL_TDATA_API_KEY=
# Server-only Seoul subway key. HTTP to the official host was explicitly approved.
# Because it travels unencrypted, it must be dedicated (different from every other key).
SEOUL_SUBWAY_API_KEY=
TIA_DATAGOKR=your_data_go_kr_service_key
DATA_GO_KR_SERVICE_KEY=your_data_go_kr_service_key_optional_alias
TIA_PROJECT_API_BASE_URL=https://api.example.go.kr/
TIA_PROJECT_API_OPERATION_PATH=/project-operation
TIA_SYSTEM_API_BASE_URL=https://api.example.go.kr/
TIA_SYSTEM_API_OPERATION_PATH=/system-operation
TIA_API_BASE_URL=https://api.example.go.kr/
TIA_API_OPERATION_PATH=/legacy-system-operation
KOSIS_API_KEY=your_kosis_api_key
DATABASE_URL=your_neon_postgres_database_url
# Optional dedicated TIA DB. Without it, reuse DATABASE_URL / POSTGRES_URL,
# then TRAFFIC_DATABASE_URL / SEOUL_BUS_DATABASE_URL / SEOUL_BUS_POSTGRES_URL.
TIA_DATABASE_URL=
# Optional bus database; TIA also reuses it when no TIA/shared binding exists.
SEOUL_BUS_DATABASE_URL=your_bus_neon_postgres_database_url
# Shared by the existing TIA sync and the monthly Seoul bus snapshot refresh.
CRON_SECRET=your_random_cron_secret
# Public summary downloads use the existing PRIVATE Blob store server-side.
# No calculator account, session secret or approval list is required for summaries.
# Never use NEXT_PUBLIC_ variables or expose Blob URLs/tokens to clients.
