{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/indicator_calculator.py": {
      "maxDuration": 60,
      "regions": ["icn1"],
      "excludeFiles": "{tests/**,.preview-test-results/**,calculator_core/src/__pycache__/**}"
    },
    "app/api/indicator/data-url/route.js": {
      "maxDuration": 15,
      "regions": ["icn1"]
    }
  },
  "crons": [
    {
      "path": "/api/cron/seoul-bus-sync",
      "schedule": "0 19 4 * *"
    },
    {
      "path": "/api/cron/tia-sync",
      "schedule": "0 18 * * *"
    }
  ]
}
